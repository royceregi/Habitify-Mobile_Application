<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Theme.Habitify" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorPrimaryVariant">@color/accent_primary_dark</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        
        <!-- Secondary colors -->
        <item name="colorSecondary">@color/accent_secondary</item>
        <item name="colorSecondaryVariant">@color/accent_warm</item>
        <item name="colorOnSecondary">@color/text_on_primary</item>
        
        <!-- Surface colors -->
        <item name="colorSurface">@color/surface_primary</item>
        <item name="colorOnSurface">@color/text_on_surface</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">@color/primary_light_gray</item>
        <item name="colorOnBackground">@color/text_primary</item>
        
        <!-- Error colors -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/text_on_primary</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/accent_primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Window properties -->
        <item name="android:windowBackground">@color/primary_light_gray</item>
        <item name="android:navigationBarColor">@color/nav_background</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        
        <!-- Typography -->
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="textAppearanceHeadline1">@style/TextAppearance.Habitify.Headline1</item>
        <item name="textAppearanceHeadline2">@style/TextAppearance.Habitify.Headline2</item>
        <item name="textAppearanceHeadline3">@style/TextAppearance.Habitify.Headline3</item>
        <item name="textAppearanceBody1">@style/TextAppearance.Habitify.Body1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.Habitify.Body2</item>
        <item name="textAppearanceCaption">@style/TextAppearance.Habitify.Caption</item>
        
        <!-- Material Components -->
        <item name="materialButtonStyle">@style/Widget.Habitify.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Habitify.CardView</item>
        <item name="bottomNavigationStyle">@style/Widget.Habitify.BottomNavigation</item>
        <item name="floatingActionButtonStyle">@style/Widget.Habitify.FloatingActionButton</item>
    </style>

    <!-- Typography Styles -->
    <style name="TextAppearance.Habitify" parent="TextAppearance.AppCompat"/>

    <style name="TextAppearance.Habitify.Headline1" parent="TextAppearance.AppCompat.Headline">
        <item name="fontFamily">@font/poppins_bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="TextAppearance.Habitify.Headline2" parent="TextAppearance.AppCompat.Title">
        <item name="fontFamily">@font/poppins_bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="TextAppearance.Habitify.Headline3" parent="TextAppearance.AppCompat.Subhead">
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TextAppearance.Habitify.Body1" parent="TextAppearance.AppCompat.Body1">
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="TextAppearance.Habitify.Body2" parent="TextAppearance.AppCompat.Body2">
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="TextAppearance.Habitify.Caption" parent="TextAppearance.AppCompat.Caption">
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.Habitify.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/accent_primary</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="rippleColor">@color/ripple_light</item>
    </style>

    <style name="Widget.Habitify.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/accent_primary</item>
        <item name="strokeColor">@color/accent_primary</item>
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="rippleColor">@color/ripple_light</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <!-- Card Styles -->
    <style name="Widget.Habitify.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="rippleColor">@color/ripple_light</item>
    </style>

    <style name="Widget.Habitify.CardView.Elevated" parent="Widget.Habitify.CardView">
        <item name="cardElevation">8dp</item>
    </style>

    <!-- Bottom Navigation Style -->
    <style name="Widget.Habitify.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/nav_background</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="android:elevation">8dp</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Habitify.BottomNavigation.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Habitify.BottomNavigation.Inactive</item>
    </style>

    <style name="TextAppearance.Habitify.BottomNavigation.Active" parent="TextAppearance.AppCompat.Caption">
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.Habitify.BottomNavigation.Inactive" parent="TextAppearance.AppCompat.Caption">
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- FloatingActionButton Style -->
    <style name="Widget.Habitify.FloatingActionButton" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/accent_primary</item>
        <item name="tint">@color/text_on_primary</item>
        <item name="rippleColor">@color/ripple_light</item>
        <item name="elevation">6dp</item>
    </style>

    <!-- Progress Indicator Styles -->
    <style name="Widget.Habitify.LinearProgressIndicator" parent="Widget.MaterialComponents.LinearProgressIndicator">
        <item name="indicatorColor">@color/accent_primary</item>
        <item name="trackColor">@color/primary_border_gray</item>
    </style>

    <!-- Shape Appearance -->
    <style name="ShapeAppearance.Habitify.FloatingActionButton" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

</resources>
