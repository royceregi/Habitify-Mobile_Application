    <color name="gradient_start">#26A69A</color>
    <color name="gradient_end">#4ECDC4</color>
    <color name="gradient_overlay_start">#1A26A69A</color>
    <color name="gradient_overlay_end">#0D4ECDC4</color>

    <!-- Legacy Support Colors -->
    <color name="black">#000000</color>
    <color name="white">#FFFFFF</color>
    <color name="transparent">#00000000</color>
    
    <!-- Backwards Compatibility (Mapped to new colors) -->
    <color name="dominant_light">@color/primary_white</color>
    <color name="dominant_white">@color/primary_white</color>
    <color name="dominant_soft_gray">@color/primary_light_gray</color>
    <color name="dominant_light_gray">@color/primary_soft_gray</color>
    <color name="dominant_medium_gray">@color/primary_medium_gray</color>
    <color name="accent_teal">@color/accent_primary</color>
    <color name="accent_ocean_blue">@color/accent_secondary</color>
    <color name="border_light">@color/primary_border_gray</color>
    <color name="text_on_accent">@color/text_on_primary</color>
