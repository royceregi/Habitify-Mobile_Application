<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Modern 60-30-10 Color Scheme - Wellness & Productivity Theme -->

    <!-- 60% Primary/Neutral Colors (Backgrounds, Surfaces) -->
    <color name="primary_white">#FFFFFF</color>
    <color name="primary_light_gray">#F8F9FA</color>
    <color name="primary_soft_gray">#F1F3F4</color>
    <color name="primary_medium_gray">#E8EAED</color>
    <color name="primary_border_gray">#E2E8F0</color>

    <!-- 30% Secondary Colors (Supporting UI Elements) -->
    <color name="secondary_soft_blue">#E3F2FD</color>
    <color name="secondary_mint_green">#E8F5E8</color>
    <color name="secondary_lavender">#F3E5F5</color>
    <color name="secondary_warm_peach">#FFF3E0</color>
    <color name="secondary_calm_teal">#E0F2F1</color>

    <!-- 10% Accent Colors (Buttons, CTAs, Highlights) -->
